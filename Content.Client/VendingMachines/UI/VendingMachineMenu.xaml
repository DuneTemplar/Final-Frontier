<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:co="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    SetSize="860 500"
    MinSize="860 320"> <!-- Frontier: added SetSize, MinSize, remove MinHeight="210" -->
    <BoxContainer Orientation="Horizontal">
	    <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="6 6 6 6" SetSize="430 260" MinSize="430 260" VerticalAlignment="Top" HorizontalAlignment="Left">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="3" BorderColor="#35434d" BackgroundColor="#191919"/>
            </PanelContainer.PanelOverride>
        <BoxContainer Name="SecondaryContainer" Orientation="Vertical">
        <!-- Final Frontier: dialogue sprite -->
        <PanelContainer VerticalExpand="False" HorizontalExpand="True">
			<TextureRect Name="BackgroundSprite" Stretch="Scale"
						 Visible="False"/>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="6" BorderColor="#212121" BackgroundColor="#111111" />
            </PanelContainer.PanelOverride>
        <BoxContainer Margin="0 0 0 0" Orientation="Horizontal" HorizontalExpand="False" HorizontalAlignment="Left">
		<!-- dialogue sprite -->
			<BoxContainer Margin="0,0,0,0" HorizontalAlignment="Center"  VerticalAlignment="Bottom">
				<TextureRect Name="DialogueSprite" HorizontalAlignment="Left" VerticalAlignment="Bottom"
							 Stretch="KeepAspect"
							 MinWidth="150" MaxWidth="150"
							 MinHeight="150" MaxHeight="150"
							 Visible="False"/>
			</BoxContainer>
        </BoxContainer>
        </PanelContainer>
		<BoxContainer Margin="8 0 4 0" Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Left">
                <Label Name="DialogueLabel"
                    StyleClasses="LabelKeyText" Text="..." />
        </BoxContainer>
        <!-- End Final Frontier: dialogue sprite -->
		
        </BoxContainer>
        </PanelContainer>
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="6 6 6 6">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="3" BorderColor="#35434d" BackgroundColor="#191919"/>
            </PanelContainer.PanelOverride>
        <BoxContainer Name="MainContainer" Orientation="Vertical">
        <!-- Frontier: balance -->
        <PanelContainer VerticalExpand="False" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="6" BorderColor="#212121" BackgroundColor="#111111" />
            </PanelContainer.PanelOverride>
        <GridContainer Margin ="0 2 0 4" Columns="2" HorizontalExpand="True">
            <BoxContainer Margin="4 0 2 0" Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Left">
                <Label Text="{Loc 'bank-atm-menu-balance-label'}"
                    StyleClasses="LabelKeyText" />
                <Label Name="BalanceLabel"
                    Text="{Loc 'bank-atm-menu-no-bank'}" />
            </BoxContainer>
            <BoxContainer Margin="2 0 4 0" Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Right" Name="CashSlotControls">
                <Label Text="{Loc 'vending-machine-menu-cash-slot-label'}"
                    StyleClasses="LabelKeyText" />
                <Label Name="CashSlotLabel"
                    Text="$0" />
            </BoxContainer>
        </GridContainer>
        </PanelContainer>
        <!-- End Frontier: balance -->
        <controls:StripeBack MinSize="48 48">
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'vending-machine-component-search-filter'}" HorizontalExpand="True"  Margin ="4 4"/>
        </controls:StripeBack>
        <co:SearchListContainer Name="VendingContents" VerticalExpand="True" Margin="4 4"/>
         <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'vending-machine-flavor-left'}" StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'vending-machine-flavor-right'}" StyleClasses="WindowFooterText"
                        HorizontalAlignment="Right" HorizontalExpand="True"  Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                        VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
        </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
